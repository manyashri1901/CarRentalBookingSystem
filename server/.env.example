# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/carrental?retryWrites=true&w=majority
# Port for local dev (hosts like Render set this automatically)
PORT=5000
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Razorpay (use TEST keys from dashboard.razorpay.com > Account & Settings > API Keys).
# Leave both empty to run in DEMO payment mode. The secret stays on the server only.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_your_test_key_secret

# Secret used to sign login tokens. REQUIRED in production: the server refuses to start
# without a strong one (at least 32 characters, not a placeholder). Generate your own,
# keep it out of git, and changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
